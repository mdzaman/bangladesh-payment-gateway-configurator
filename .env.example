# bdpay cloud configuration for a deployment. Copy to .env (never commit it), or
# set these in your orchestrator's secret store. `bdpay-cloud doctor` checks the result.
#
# You do not need this file to try it: `docker compose up -d --build` and `make dev`
# both run with defaults.

# --- docker compose only ------------------------------------------------------------
# Site address for the bundled Caddy proxy. A real domain gets HTTPS automatically.
BDPAY_SITE_ADDRESS=http://localhost
BDPAY_HTTP_PORT=8080
BDPAY_HTTPS_PORT=8443
POSTGRES_PASSWORD=bdpay

# --- deployment -------------------------------------------------------------------------
# development | production. Production refuses to start with unsafe settings.
BDPAY_CLOUD_ENV=development
# Public https origin of this service. Providers send customers and IPNs here.
BDPAY_CLOUD_PUBLIC_URL=http://localhost:8080
BDPAY_CLOUD_BRAND_NAME=bdpay cloud
BDPAY_CLOUD_SUPPORT_EMAIL=

# --- storage ------------------------------------------------------------------
# docker-compose.yml sets the database and Redis addresses itself. Set them when
# you run the image anywhere else.
# BDPAY_CLOUD_DATABASE_URL=postgresql+psycopg://bdpay:password@db-host:5432/bdpay_cloud
BDPAY_CLOUD_DB_POOL_SIZE=10
BDPAY_CLOUD_DB_MAX_OVERFLOW=20
# true when connecting through PgBouncer in transaction mode
BDPAY_CLOUD_DB_PGBOUNCER=false
# Optional. Makes rate limits exact across replicas.
# BDPAY_CLOUD_REDIS_URL=redis://redis-host:6379/0

# --- encryption of tenant secrets ------------------------------------------------
# REQUIRED in production. Generate with: bdpay-cloud gen-key
# Format: id:base64key[,older-id:older-key]. The first key encrypts.
# Losing every key here means the stored gateway credentials cannot be read.
BDPAY_CLOUD_MASTER_KEYS=

# --- product switches -------------------------------------------------------------
BDPAY_CLOUD_ALLOW_SIGNUP=true
# self_serve | approval | disabled
BDPAY_CLOUD_LIVE_MODE=self_serve
BDPAY_CLOUD_REQUIRE_VERIFIED_EMAIL_FOR_LIVE=true
# UddoktaPay-style wallet automation. Read docs/compliance.md before enabling.
BDPAY_CLOUD_ALLOW_EXPERIMENTAL=false
# Built-in fake provider for sandbox mode.
BDPAY_CLOUD_SIMULATOR=true
# Outbound IPv4 of this deployment, shown to merchants for Nagad/Upay whitelisting.
BDPAY_CLOUD_EGRESS_IPS=
# Hosts workspaces may use for a gateway base-URL override, e.g. ".upaybd.com".
# Empty allows any public host; set it on a shared deployment.
BDPAY_CLOUD_BASE_URL_ALLOWLIST=
# Development only (SSRF): lets webhooks and base URLs reach private addresses.
BDPAY_CLOUD_ALLOW_PRIVATE_TARGETS=false

# --- limits ------------------------------------------------------------------------
BDPAY_CLOUD_API_RATE_PER_MINUTE=600
BDPAY_CLOUD_LOGIN_RATE_PER_15MIN=10
BDPAY_CLOUD_SIGNUP_RATE_PER_HOUR=30
BDPAY_CLOUD_HOSTED_RATE_PER_MINUTE=600
BDPAY_CLOUD_SESSION_IDLE_HOURS=12
BDPAY_CLOUD_SESSION_MAX_DAYS=14
BDPAY_CLOUD_CHECKOUT_SESSION_TTL_MINUTES=60

# --- workers ------------------------------------------------------------------------
BDPAY_CLOUD_THREADPOOL_SIZE=64
BDPAY_CLOUD_WORKER_CONCURRENCY=8
BDPAY_CLOUD_WORKER_POLL_SECONDS=2
BDPAY_CLOUD_RECONCILE_EXPIRE_HOURS=24
BDPAY_CLOUD_WEBHOOK_TIMEOUT_SECONDS=10

# --- mail ------------------------------------------------------------------------------
# console prints messages to the log (development). Use smtp in production.
BDPAY_CLOUD_MAIL_BACKEND=console
BDPAY_CLOUD_MAIL_FROM=bdpay cloud <no-reply@localhost>
BDPAY_CLOUD_SMTP_HOST=127.0.0.1
BDPAY_CLOUD_SMTP_PORT=1025
BDPAY_CLOUD_SMTP_USERNAME=
BDPAY_CLOUD_SMTP_PASSWORD=
# none | starttls | ssl
BDPAY_CLOUD_SMTP_TLS=none

# --- operations --------------------------------------------------------------------------
BDPAY_CLOUD_LOG_LEVEL=INFO
# json | text
BDPAY_CLOUD_LOG_FORMAT=json
# If set, GET /metrics needs "Authorization: Bearer <token>".
BDPAY_CLOUD_METRICS_TOKEN=
BDPAY_CLOUD_DOCS_ENABLED=true
# Folder with the built dashboard. The container image sets this itself.
# BDPAY_CLOUD_WEB_DIST=/app/web-dist
