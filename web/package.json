{
  "name": "bdpay-cloud-web",
  "private": true,
  "version": "1.0.0",
  "description": "Dashboard, gateway configurator and self-host generator for bdpay cloud",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "bundle": "node scripts/bundle-core.mjs",
    "predev": "node scripts/bundle-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/bundle-core.mjs",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "node scripts/bundle-core.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/bundle-core.mjs",
    "test": "vitest run",
    "lint": "oxlint src scripts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
